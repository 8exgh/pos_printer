{
  "name": "pos-printer-api",
  "version": "1.0.0",
  "description": "CQRS+ES POS Printer Management System for Star Micronics TSP100",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "init-db": "ts-node scripts/init-databases.ts",
    "test-printer": "ts-node scripts/test-printer.ts",
    "start:api": "ts-node src/api/server.ts",
    "start:processor": "ts-node src/processor/background-processor.ts",
    "dev:api": "ts-node-dev --respawn src/api/server.ts",
    "dev:processor": "ts-node-dev --respawn src/processor/background-processor.ts",
    "clean": "rm -rf dist writemodel.db readmodel.db"
  },
  "keywords": ["pos", "printer", "cqrs", "event-sourcing"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
